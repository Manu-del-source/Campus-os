// CampusOS — multi-tenant SaaS for colleges and TVET institutions.
//
// Conventions
// -----------
// * Every institution-owned table carries `institutionId` and is indexed on it.
// * Uniqueness of business keys is ALWAYS scoped by `institutionId`
//   (e.g. a student number is unique per institution, never globally).
// * Identifiers are UUIDv7 — non-sequential across tenants but index friendly.
// * Records with legal/academic weight are soft-deleted (`deletedAt`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum InstitutionType {
  TVET
  TECHNICAL_COLLEGE
  NATIONAL_POLYTECHNIC
  UNIVERSITY_COLLEGE
  PRIVATE_COLLEGE
  OTHER
}

enum RoleScope {
  PLATFORM
  INSTITUTION
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

enum DurationUnit {
  WEEK
  MONTH
  TERM
  SEMESTER
  YEAR
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum IntakeStatus {
  PLANNED
  OPEN
  CLOSED
  CANCELLED
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  SUSPENDED
  DEFERRED
  COMPLETED
  GRADUATED
  WITHDRAWN
  DISCONTINUED
}

enum StaffEmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  CONTRACT_ENDED
  TERMINATED
  RETIRED
}

enum StaffCategory {
  ACADEMIC
  ADMINISTRATIVE
  SUPPORT
  MANAGEMENT
}

enum UnitType {
  CORE
  ELECTIVE
  COMMON
  INDUSTRIAL_ATTACHMENT
  PROJECT
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  DROPPED
  WITHDRAWN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  EXAM
  ASSIGNMENT
  QUIZ
  PROJECT
  PRACTICAL
  COURSEWORK
  PRESENTATION
  OTHER
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  SUBMISSION_OPEN
  SUBMISSION_CLOSED
  GRADED
  PUBLISHED_RESULTS
}

enum MarkStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  PUBLISHED
}

enum ResultStatus {
  PENDING
  CALCULATED
  VERIFIED
  APPROVED
  PUBLISHED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MPESA
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
  INTEGRATION
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DocumentKind {
  IDENTITY
  ACADEMIC_CERTIFICATE
  TRANSCRIPT
  OFFER_LETTER
  SUPPORTING
  OTHER
}

enum DocumentVisibility {
  PRIVATE
  STAFF
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// The tenant root. Everything else in the product hangs off this record.
model Institution {
  id        String            @id @default(uuid(7)) @db.Uuid
  /// URL/sub-domain safe tenant key, e.g. "demo-college".
  slug      String            @unique
  name      String
  shortName String?
  type      InstitutionType   @default(TVET)
  status    InstitutionStatus @default(PENDING)

  registrationNumber String?
  email              String?
  phone              String?
  websiteUrl         String?
  logoUrl            String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  county             String?
  country            String  @default("KE")
  postalCode         String?

  /// IANA timezone used for timetable/attendance rendering.
  timezone String @default("Africa/Nairobi")
  /// ISO-4217 currency used by the finance module.
  currency String @default("KES")
  locale   String @default("en-KE")

  /// Tenant-scoped configuration (branding, numbering formats, module toggles).
  settings Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campuses      Campus[]
  users         User[]
  roles         Role[]
  userRoles     UserRole[]
  departments   Department[]
  programmes    Programme[]
  academicLevels AcademicLevel[]
  academicYears AcademicYear[]
  intakes       Intake[]
  cohorts       Cohort[]
  groups        Group[]
  semesters     Semester[]
  units         Unit[]
  staff         Staff[]
  students      Student[]
  applications  Application[]
  admissions    Admission[]
  documents     Document[]
  auditLogs     AuditLog[]
  unitRegistrations UnitRegistration[]
  rooms         Room[]
  timetableEntries TimetableEntry[]
  attendanceSessions AttendanceSession[]
  attendanceRecords AttendanceRecord[]
  assessments   Assessment[]
  marks         Mark[]
  results       Result[]
  feeStructures FeeStructure[]
  feeItems      FeeItem[]
  invoices      Invoice[]
  invoiceItems  InvoiceItem[]
  payments      Payment[]
  paymentAllocations PaymentAllocation[]
  receipts      Receipt[]
  notifications Notification[]
  subscription Subscription?

  @@index([status])
  @@map("institutions")
}

model Campus {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid

  code         String
  name         String
  isMain       Boolean @default(false)
  addressLine1 String?
  city         String?
  county       String?
  phone        String?
  email        String?
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments  Department[]
  staff        Staff[]
  students     Student[]
  groups       Group[]
  applications Application[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("campuses")
}

// ---------------------------------------------------------------------------
// Identity, roles and permissions
// ---------------------------------------------------------------------------

/// Application user with native authentication (Argon2id password hashes & session records).
/// Platform administrators have a null `institutionId`; everyone else is
/// permanently bound to exactly one tenant.
model User {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String? @db.Uuid

  authUserId   String? @unique @db.Uuid
  email        String
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?

  status          UserStatus @default(INVITED)
  isPlatformAdmin Boolean    @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution            Institution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userRoles              UserRole[]
  sessions               Session[]
  staffProfile           Staff?
  studentRecord          Student?
  reviewedApplications   Application[] @relation("ApplicationReviewer")
  uploadedDocuments      Document[]    @relation("DocumentUploader")
  auditLogs              AuditLog[]
  attendanceMarked       AttendanceRecord[]
  marksGraded            Mark[]
  resultsVerified        Result[] @relation("ResultsVerified")
  resultsApproved        Result[] @relation("ResultsApproved")
  confirmedPayments      Payment[]
  notifications          Notification[]
  subscriptionEvents     SubscriptionEvent[]

  @@unique([institutionId, email])
  @@index([institutionId])
  @@index([email])
  @@map("users")
}

/// Active database-backed user session. Tokens are stored only as SHA-256 hashes.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

/// Roles are either platform-wide system roles (`institutionId` null) or
/// tenant-defined roles. `key` is the stable machine name used in code.
model Role {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String? @db.Uuid

  key         String
  name        String
  description String?
  scope       RoleScope @default(INSTITUTION)
  /// System roles are seeded by CampusOS and cannot be deleted by tenants.
  isSystem    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([institutionId, key])
  @@index([institutionId])
  @@map("roles")
}

/// Global catalogue of granular permissions, e.g. `students.read`.
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  /// Coarse grouping used by the permission matrix UI, e.g. `students`.
  module      String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid(7)) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Role assignment. `institutionId` is denormalised so tenant filters can be
/// applied without joining through `users`.
model UserRole {
  id            String  @id @default(uuid(7)) @db.Uuid
  userId        String  @db.Uuid
  roleId        String  @db.Uuid
  institutionId String? @db.Uuid

  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, institutionId])
  @@index([institutionId])
  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Department {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  campusId      String? @db.Uuid

  code        String
  name        String
  description String?
  headStaffId String? @unique @db.Uuid
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus      Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  head        Staff?      @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  programmes  Programme[]
  staff       Staff[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("departments")
}

/// Qualification level (KNQF level, certificate/diploma tier, ...).
/// Configurable per institution — CampusOS never hard-codes a ladder.
model AcademicLevel {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid

  code        String
  name        String
  /// Ordering rank used for progression and reporting (e.g. 4, 5, 6).
  rank        Int
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programmes  Programme[]
  units       Unit[]
  students    Student[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("academic_levels")
}

model Programme {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  departmentId  String  @db.Uuid
  levelId       String? @db.Uuid

  code        String
  name        String
  description String?

  duration     Int
  durationUnit DurationUnit @default(YEAR)
  /// Number of academic stages (years/blocks) a learner progresses through.
  stages       Int          @default(1)

  /// Awarding/examining body, e.g. a national qualifications authority.
  examiningBody       String?
  accreditationNumber String?
  accreditedUntil     DateTime?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  level       AcademicLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  units        Unit[]
  cohorts      Cohort[]
  students     Student[]
  applications Application[]
  feeStructures FeeStructure[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, departmentId])
  @@index([institutionId, levelId])
  @@map("programmes")
}

model AcademicYear {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid

  code      String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// Exactly one academic year per institution may be current (enforced in code).
  isCurrent Boolean  @default(false)
  status    AcademicPeriodStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  intakes     Intake[]
  semesters   Semester[]
  cohorts     Cohort[]
  feeStructures FeeStructure[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, isCurrent])
  @@map("academic_years")
}

model Intake {
  id             String @id @default(uuid(7)) @db.Uuid
  institutionId  String @db.Uuid
  academicYearId String @db.Uuid

  code            String
  name            String
  startDate       DateTime     @db.Date
  endDate         DateTime?    @db.Date
  applicationOpen DateTime?
  applicationClose DateTime?
  status          IntakeStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  cohorts      Cohort[]
  students     Student[]
  applications Application[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, academicYearId])
  @@index([institutionId, status])
  @@map("intakes")
}

model Semester {
  id             String @id @default(uuid(7)) @db.Uuid
  institutionId  String @db.Uuid
  academicYearId String @db.Uuid

  code        String
  name        String
  /// Position within the academic year (1, 2, 3 ...).
  sequence    Int
  startDate   DateTime             @db.Date
  endDate     DateTime             @db.Date
  isCurrent   Boolean              @default(false)
  status      AcademicPeriodStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  units        Unit[]
  unitRegistrations UnitRegistration[]
  timetableEntries TimetableEntry[]
  assessments Assessment[]
  results     Result[]
  invoices    Invoice[]

  @@unique([institutionId, code])
  @@unique([academicYearId, sequence])
  @@index([institutionId])
  @@index([institutionId, isCurrent])
  @@map("semesters")
}

/// A cohort is one programme intake: the learners admitted together.
/// Example key: ICT-DIP-SEP26.
model Cohort {
  id             String  @id @default(uuid(7)) @db.Uuid
  institutionId  String  @db.Uuid
  programmeId    String  @db.Uuid
  intakeId       String  @db.Uuid
  academicYearId String? @db.Uuid

  code        String
  name        String
  /// Current stage of the cohort within the programme (year 1, year 2 ...).
  currentStage Int     @default(1)
  startDate   DateTime? @db.Date
  expectedEndDate DateTime? @db.Date
  status      AcademicPeriodStatus @default(PLANNED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programme    Programme     @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  intake       Intake        @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  groups       Group[]
  students     Student[]
  admissions   Admission[]
  feeStructures FeeStructure[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, programmeId])
  @@index([institutionId, intakeId])
  @@map("cohorts")
}

/// A teachable subdivision of a cohort. Groups — not "streams" — are what the
/// timetable, attendance and lecturer allocation modules schedule against.
model Group {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  cohortId      String  @db.Uuid
  campusId      String? @db.Uuid

  code     String
  name     String
  capacity Int?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  cohort      Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  campus      Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  students    Student[]
  admissions  Admission[]
  timetableEntries TimetableEntry[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, cohortId])
  @@map("groups")
}

model Unit {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  programmeId   String  @db.Uuid
  levelId       String? @db.Uuid
  semesterId    String? @db.Uuid

  code        String
  name        String
  description String?
  type        UnitType @default(CORE)

  creditHours  Int?
  contactHours Int?
  /// Programme stage in which the unit is normally taken.
  stage        Int  @default(1)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programme   Programme      @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  level       AcademicLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  semester    Semester?      @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  registrations UnitRegistration[]
  timetableEntries TimetableEntry[]
  assessments Assessment[]
  results     Result[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, programmeId])
  @@index([institutionId, semesterId])
  @@map("units")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Staff {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  userId        String? @unique @db.Uuid
  departmentId  String? @db.Uuid
  campusId      String? @db.Uuid

  staffNumber String
  firstName   String
  middleName  String?
  lastName    String
  email       String
  phone       String?
  nationalId  String?
  gender      Gender?
  dateOfBirth DateTime? @db.Date

  category         StaffCategory         @default(ACADEMIC)
  jobTitle         String?
  employmentStatus StaffEmploymentStatus @default(ACTIVE)
  employmentDate   DateTime?             @db.Date
  exitDate         DateTime?             @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  campus          Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  headsDepartment Department? @relation("DepartmentHead")
  timetableEntries TimetableEntry[]

  @@unique([institutionId, staffNumber])
  @@unique([institutionId, email])
  @@index([institutionId])
  @@index([institutionId, departmentId])
  @@index([institutionId, employmentStatus])
  @@map("staff")
}

model Student {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  userId        String? @unique @db.Uuid

  studentNumber        String
  applicationReference String?

  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  dateOfBirth   DateTime? @db.Date
  gender        Gender?
  nationalId    String?
  nationality   String    @default("KE")
  email         String?
  phone         String?
  photoUrl      String?

  addressLine1 String?
  city         String?
  county       String?
  postalCode   String?

  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianEmail        String?
  emergencyContactName  String?
  emergencyContactPhone String?

  programmeId String? @db.Uuid
  levelId     String? @db.Uuid
  intakeId    String? @db.Uuid
  cohortId    String? @db.Uuid
  groupId     String? @db.Uuid
  campusId    String? @db.Uuid

  status        StudentStatus @default(APPLICANT)
  admissionDate DateTime?     @db.Date
  completionDate DateTime?    @db.Date
  /// Free-form notes are deliberately excluded here; use documents/audit trail.

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Student records are never hard-deleted; they are archived.
  deletedAt DateTime?

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  programme   Programme?     @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  level       AcademicLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  intake      Intake?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  cohort      Cohort?        @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  campus      Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  admission   Admission?
  documents   Document[]
  unitRegistrations UnitRegistration[]
  attendanceRecords AttendanceRecord[]
  marks       Mark[]
  results     Result[]
  invoices    Invoice[]
  payments    Payment[]

  @@unique([institutionId, studentNumber])
  @@unique([institutionId, applicationReference])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, programmeId])
  @@index([institutionId, cohortId])
  @@index([institutionId, groupId])
  @@index([institutionId, intakeId])
  @@index([institutionId, lastName])
  @@map("students")
}

// ---------------------------------------------------------------------------
// Admissions
// ---------------------------------------------------------------------------

/// A public application to an institution. References are unique per tenant
/// and generated with a non-sequential suffix so they cannot be guessed.
model Application {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  programmeId   String  @db.Uuid
  intakeId      String  @db.Uuid
  campusId      String? @db.Uuid

  /// Tenant-scoped public reference, e.g. APP-2026-K7M2QX.
  reference String
  status    ApplicationStatus @default(DRAFT)

  firstName   String
  middleName  String?
  lastName    String
  email       String
  phone       String?
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  nationalId  String?
  nationality String    @default("KE")

  addressLine1 String?
  city         String?
  county       String?
  postalCode   String?

  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianEmail        String?

  /// SHA-256 hex of the one-time public access token. The raw token is shown
  /// only at creation so the applicant can resume without an account.
  accessTokenHash String

  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?   @db.Uuid
  decisionNote String?
  withdrawnAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programme   Programme   @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  intake      Intake      @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  campus      Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  reviewedBy  User?       @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  admission   Admission?
  documents   Document[]

  @@unique([institutionId, reference])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, programmeId])
  @@index([institutionId, intakeId])
  @@index([institutionId, email])
  @@map("applications")
}

/// The offer / registration record that sits between an accepted application
/// and the resulting Student. Created when an offer is issued.
model Admission {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  applicationId String  @unique @db.Uuid
  studentId     String? @unique @db.Uuid
  cohortId      String? @db.Uuid
  groupId       String? @db.Uuid

  offerIssuedAt   DateTime
  offerExpiresAt  DateTime?
  offerAcceptedAt DateTime?
  registeredAt    DateTime?
  conditions      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  cohort      Cohort?     @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  group       Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@map("admissions")
}

/// Metadata for a private file. Bytes live in object storage (or the local
/// disk adapter); PostgreSQL never stores the payload.
model Document {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String  @db.Uuid
  applicationId String? @db.Uuid
  studentId     String? @db.Uuid
  uploadedById  String? @db.Uuid

  kind       DocumentKind
  fileName   String
  mimeType   String
  byteSize   Int
  storageKey String
  checksum   String?
  visibility DocumentVisibility @default(PRIVATE)

  createdAt DateTime @default(now())

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([institutionId, applicationId])
  @@index([institutionId, studentId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Unit registration
// ---------------------------------------------------------------------------

/// Links a student to a unit for a specific semester. This is the enrollment
/// record that drives timetable, attendance, and assessment eligibility.
model UnitRegistration {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid
  unitId        String @db.Uuid
  semesterId    String @db.Uuid

  status        RegistrationStatus @default(PENDING)
  registeredAt  DateTime            @default(now())
  droppedAt     DateTime?
  withdrawAt    DateTime?
  dropReason    String?
  withdrawReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  semester    Semester    @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@unique([institutionId, studentId, unitId, semesterId])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, unitId])
  @@index([institutionId, semesterId])
  @@index([institutionId, status])
  @@map("unit_registrations")
}

// ---------------------------------------------------------------------------
// Timetable
// ---------------------------------------------------------------------------

/// Physical or virtual room. Tenant-scoped.
model Room {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid

  code     String
  name     String
  building String?
  floor    Int?
  capacity Int?
  roomType String?  @default("CLASSROOM")
  isActive Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  entries     TimetableEntry[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("rooms")
}

/// A scheduled recurring class session. The timetable module validates that
/// no lecturer, room, or group is double-booked before saving.
model TimetableEntry {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  semesterId    String @db.Uuid
  unitId        String @db.Uuid
  staffId       String @db.Uuid
  roomId        String @db.Uuid
  groupId       String @db.Uuid

  dayOfWeek  DayOfWeek
  startTime  DateTime @db.Time
  endTime    DateTime @db.Time
  weekStart  Int?  @default(1)
  weekEnd    Int?
  isActive   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semester    Semester            @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  unit        Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  staff       Staff               @relation(fields: [staffId], references: [id], onDelete: Restrict)
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  sessions    AttendanceSession[]

  @@index([institutionId])
  @@index([institutionId, semesterId])
  @@index([institutionId, staffId])
  @@index([institutionId, roomId])
  @@index([institutionId, groupId])
  @@index([institutionId, unitId])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

/// A specific occurrence of a timetable entry (e.g. Monday 9am on a given date).
model AttendanceSession {
  id               String @id @default(uuid(7)) @db.Uuid
  institutionId    String @db.Uuid
  timetableEntryId String @db.Uuid
  sessionId        String @unique @db.Uuid

  sessionDate  DateTime @db.Date
  startTime    DateTime @db.Time
  endTime      DateTime @db.Time
  topic        String?
  notes        String?
  isCancelled  Boolean  @default(false)
  cancelledReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  timetableEntry TimetableEntry  @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  records       AttendanceRecord[]

  @@unique([institutionId, timetableEntryId, sessionDate])
  @@index([institutionId])
  @@index([institutionId, timetableEntryId])
  @@index([institutionId, sessionDate])
  @@map("attendance_sessions")
}

/// Individual student attendance for a session.
model AttendanceRecord {
  id               String @id @default(uuid(7)) @db.Uuid
  institutionId    String @db.Uuid
  attendanceSessionId String @db.Uuid
  studentId        String @db.Uuid

  status     AttendanceStatus @default(ABSENT)
  markedById String?  @db.Uuid
  notes      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  institution    Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  session        AttendanceSession  @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy       User?              @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([institutionId, attendanceSessionId, studentId])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, attendanceSessionId])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Assessment & results
// ---------------------------------------------------------------------------

/// A graded item (exam, assignment, quiz, etc.) linked to a unit and semester.
model Assessment {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  unitId        String @db.Uuid
  semesterId    String @db.Uuid

  code         String
  name         String
  description  String?
  type         AssessmentType @default(COURSEWORK)
  maxScore     Float
  weight       Float          @default(0)
  status       AssessmentStatus @default(DRAFT)

  dueDate      DateTime?
  publishedAt  DateTime?
  gradedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  marks       Mark[]

  @@unique([institutionId, unitId, semesterId, code])
  @@index([institutionId])
  @@index([institutionId, unitId])
  @@index([institutionId, semesterId])
  @@map("assessments")
}

/// Individual student marks for an assessment.
model Mark {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  assessmentId  String @db.Uuid
  studentId     String @db.Uuid

  score       Float?
  percentage  Float?
  grade       String?
  status      MarkStatus @default(DRAFT)
  feedback    String?
  gradedById  String?  @db.Uuid
  gradedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assessment  Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy    User?        @relation(fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([institutionId, assessmentId, studentId])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, assessmentId])
  @@map("marks")
}

/// Aggregated result for a student in a unit for a semester.
/// Calculated from marks and grading configuration.
model Result {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid
  unitId        String @db.Uuid
  semesterId    String @db.Uuid

  totalScore    Float?
  percentage    Float?
  grade         String?
  gpa           Float?
  status        ResultStatus @default(PENDING)
  remarks       String?
  calculatedAt  DateTime?
  verifiedById  String?  @db.Uuid
  verifiedAt    DateTime?
  approvedById  String?  @db.Uuid
  approvedAt    DateTime?
  publishedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  verifiedBy  User?        @relation("ResultsVerified", fields: [verifiedById], references: [id], onDelete: SetNull)
  approvedBy  User?        @relation("ResultsApproved", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([institutionId, studentId, unitId, semesterId])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, unitId])
  @@index([institutionId, semesterId])
  @@index([institutionId, status])
  @@map("results")
}

// ---------------------------------------------------------------------------
// Auditing
// ---------------------------------------------------------------------------

/// Append-only trail. Application code never updates or deletes rows here.
model AuditLog {
  id            String  @id @default(uuid(7)) @db.Uuid
  institutionId String? @db.Uuid
  actorUserId   String? @db.Uuid

  actorType   AuditActorType @default(USER)
  actorLabel  String?
  action      String
  entityType  String
  entityId    String?
  summary     String?
  metadata    Json           @default("{}")
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([institutionId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

/// A fee structure defines what charges apply to a programme or cohort.
model FeeStructure {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  programmeId   String? @db.Uuid
  cohortId      String? @db.Uuid
  academicYearId String? @db.Uuid

  code        String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution  Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programme    Programme?  @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  cohort       Cohort?     @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  feeItems     FeeItem[]
  invoices     Invoice[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("fee_structures")
}

/// Individual line items within a fee structure.
model FeeItem {
  id             String @id @default(uuid(7)) @db.Uuid
  institutionId  String @db.Uuid
  feeStructureId String @db.Uuid

  code         String
  name         String
  description  String?
  amount       Float
  isMandatory  Boolean @default(true)
  isRecurring  Boolean @default(false)
  recurringPeriod String?  // e.g. "SEMESTER", "MONTH"
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@unique([institutionId, feeStructureId, code])
  @@index([institutionId])
  @@index([institutionId, feeStructureId])
  @@map("fee_items")
}

/// An invoice issued to a student for a set of fee items.
model Invoice {
  id             String @id @default(uuid(7)) @db.Uuid
  institutionId  String @db.Uuid
  feeStructureId String? @db.Uuid
  studentId      String @db.Uuid
  semesterId     String? @db.Uuid

  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  total          Float         @default(0)
  amountPaid     Float         @default(0)
  balance        Float         @default(0)
  currency       String        @default("KES")

  dueDate        DateTime?
  issuedAt       DateTime?
  cancelledAt    DateTime?
  cancelledReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution  Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure?  @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semester     Semester?      @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  allocations  PaymentAllocation[]

  @@unique([institutionId, invoiceNumber])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, status])
  @@index([institutionId, semesterId])
  @@map("invoices")
}

/// Line item on an invoice, referencing a fee item or ad-hoc charge.
model InvoiceItem {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  invoiceId     String @db.Uuid
  feeItemId     String? @db.Uuid

  code         String
  name         String
  description  String?
  quantity     Int      @default(1)
  unitPrice    Float
  discount     Float    @default(0)
  total        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem     FeeItem?     @relation(fields: [feeItemId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([institutionId, invoiceId])
  @@map("invoice_items")
}

/// A payment record against one or more invoices.
model Payment {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid

  paymentNumber String
  reference     String?  // External reference (e.g. M-Pesa transaction ID)
  method        PaymentMethod @default(CASH)
  amount        Float
  currency      String   @default("KES")
  status        PaymentStatus @default(PENDING)

  notes         String?
  receivedAt    DateTime?
  confirmedAt   DateTime?
  confirmedById String?  @db.Uuid
  voidedAt      DateTime?
  voidedReason  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  confirmedBy User?       @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  receipts    Receipt[]

  @@unique([institutionId, paymentNumber])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, status])
  @@map("payments")
}

/// Maps a payment amount to a specific invoice.
model PaymentAllocation {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  paymentId     String @db.Uuid
  invoiceId     String @db.Uuid

  amount      Float
  allocatedAt DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([institutionId, paymentId, invoiceId])
  @@index([institutionId])
  @@index([institutionId, paymentId])
  @@index([institutionId, invoiceId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String? @db.Uuid
  recipientId   String @db.Uuid

  title     String
  body      String
  kind      String  @default("INFO")
  link      String?
  isRead    Boolean @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  recipient   User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

/// A receipt issued for a confirmed payment.
model Receipt {
  id            String @id @default(uuid(7)) @db.Uuid
  institutionId String @db.Uuid
  paymentId     String @db.Uuid

  receiptNumber String
  issuedAt      DateTime @default(now())
  notes         String?

  createdAt DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([institutionId, receiptNumber])
  @@index([institutionId])
  @@index([institutionId, paymentId])
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// Subscriptions (platform-level)
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

/// Pricing plan available to institutions.
model Plan {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  /// Monthly price in the platform currency.
  price       Float
  interval    PlanInterval @default(MONTHLY)

  /// Configurable limits. null = unlimited.
  maxStudents Int?
  maxStaff    Int?
  maxStorageMb Int?
  maxUnits    Int?

  /// Feature flags enabled for this plan.
  features    Json @default("[]")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

/// Institution subscription to a plan.
model Subscription {
  id             String @id @default(uuid(7)) @db.Uuid
  institutionId  String @unique @db.Uuid
  planId         String @db.Uuid

  status         SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEnd      DateTime?
  cancelledAt   DateTime?
  cancelAtPeriodEnd Boolean @default(false)

  /// Stripe/payment provider subscription ID.
  externalId    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  events      SubscriptionEvent[]
  usage       UsageRecord[]

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

/// Subscription lifecycle events (for audit trail).
model SubscriptionEvent {
  id             String @id @default(uuid(7)) @db.Uuid
  subscriptionId String @db.Uuid

  type         String   // e.g. "created", "plan_changed", "cancelled", "renewed", "payment_failed"
  description  String?
  metadata     Json     @default("{}")
  performedById String? @db.Uuid

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  performedBy  User?        @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([createdAt])
  @@map("subscription_events")
}

/// Usage tracking for metered billing and limit enforcement.
model UsageRecord {
  id             String @id @default(uuid(7)) @db.Uuid
  subscriptionId String @db.Uuid

  /// What is being measured (e.g. "students", "staff", "storage_mb", "units").
  metric        String
  quantity      Int
  /// The billing period this record belongs to.
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, metric, periodStart])
  @@index([subscriptionId])
  @@map("usage_records")
}

