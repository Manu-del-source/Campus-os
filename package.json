{
  "name": "campus-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.mts",
    "db:deploy": "tsx --env-file-if-exists=.env scripts/migrate.mts deploy",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.mts reset",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:local": "tsx scripts/local-db.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "clsx": "^2.1.1",
    "next": "15.5.4",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@prisma/driver-adapter-utils": "^7.9.1",
    "@prisma/schema-engine-wasm": "^7.9.0-1.e922089b7d7502aff4249d5da3420f6fa55fc6ad",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
