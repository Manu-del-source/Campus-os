# ---------------------------------------------------------------------------
# CampusOS environment
# Copy to `.env` and fill in real values. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL (Supabase-compatible). DATABASE_URL may be a pooled connection;
# DIRECT_URL must bypass the pooler and is used for migrations.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/campusos"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/campusos"
# Optional: used by `prisma migrate dev` when a shadow database is required.
SHADOW_DATABASE_URL=""

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Must never be exposed to the browser or prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Development convenience: impersonate a seeded user when Supabase Auth is not
# configured. Ignored in production builds.
CAMPUSOS_DEV_LOGIN_EMAIL=""

# ---------------------------------------------------------------------------
# Planned integrations (not yet wired up — placeholders only)
# ---------------------------------------------------------------------------

# M-Pesa Daraja (server-only secrets)
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""

# Object storage for documents (Supabase Storage bucket)
SUPABASE_STORAGE_BUCKET="campusos-documents"

# Email / SMS providers
EMAIL_FROM="no-reply@example.com"
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
