# ---------------------------------------------------------------------------
# CampusOS environment
# Copy to `.env` and fill in real values. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL. DATABASE_URL may be a pooled connection;
# DIRECT_URL must bypass the pooler and is used for migrations.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/campusos"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/campusos"
# Optional: used by `prisma migrate dev` when a shadow database is required.
SHADOW_DATABASE_URL=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Development convenience: impersonate a seeded user.
# Ignored in production builds.
CAMPUSOS_DEV_LOGIN_EMAIL=""

# ---------------------------------------------------------------------------
# Planned integrations (not yet wired up — placeholders only)
# ---------------------------------------------------------------------------

# M-Pesa Daraja (server-only secrets)
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""

# Object storage for documents. Bytes go on disk (or a mounted bucket);
# PostgreSQL stores only metadata. DOCUMENT_SIGNING_SECRET signs download URLs.
DOCUMENT_STORAGE_DIR=""
DOCUMENT_SIGNING_SECRET=""

# Email / SMS providers
EMAIL_FROM="no-reply@example.com"
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
